<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PvzheRelayCli</AssemblyName>
    <RootNamespace>PvzheRelayCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- 复用中继/MOD 的同一份协议源码 -->
    <Compile Include="..\..\mod\PvzheMod\Net\NetBitCodec.cs" Link="NetBitCodec.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetProtocol.cs" Link="NetProtocol.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetCrypto.cs" Link="NetCrypto.cs" />
    <!-- v3 加密层：握手要用 NetSecureSession（它依赖 Sha256/Aes/X25519） -->
    <Compile Include="..\..\mod\PvzheMod\Net\NetSha256.cs" Link="NetSha256.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetAes.cs" Link="NetAes.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetX25519.cs" Link="NetX25519.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetSecure.cs" Link="NetSecure.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetRoomSettings.cs" Link="NetRoomSettings.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetPeers.cs" Link="NetPeers.cs" />
    <Compile Include="..\..\mod\PvzheMod\Net\NetLobby.cs" Link="NetLobby.cs" />
  </ItemGroup>
</Project>
