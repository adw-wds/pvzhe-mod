<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PvzheMod</AssemblyName>
    <RootNamespace>PvzheMod</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>

    <!-- ★ 2026-10-08 修正：原 HintPath 写死 0.27，而该目录已被删除 ⇒ GodotSharp 引用失败
         ⇒ 550 个 "未能找到类型 Node/Node2D/Vector2I"。改成可覆盖属性，默认指向当前在用的 0.29。
         换版本时用 -p:GameDataDir="...\data_PlantsVsZombies_windows_x86_64" 覆盖即可，不用改文件。 -->
    <GameDataDir Condition="'$(GameDataDir)' == ''"><你的游戏目录></GameDataDir>
  </PropertyGroup>
  <ItemGroup>
    <!-- 引用游戏目录的 GodotSharp（Godot C# API） -->
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
