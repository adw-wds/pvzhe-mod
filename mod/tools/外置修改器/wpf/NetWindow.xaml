<Window x:Class="PvzheRemote.NetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="联机 · 杂交版" Height="700" Width="840" MinHeight="620" MinWidth="760"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 卡片（Win10：白底 + 1px 细线 + 圆角 4，无阴影） -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 页签（Win10：直角、hover 灰） -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮（Win10 强调蓝） -->
        <Style x:Key="Primary" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#106EBE"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 次要按钮（Win10：白底 + 1px 灰边） -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="2"
                                BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Foreground" Value="#C42B1C"/>
        </Style>

        <!-- 房间块（Win10：白底细线，hover 蓝边） -->
        <Style x:Key="RoomItem" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Background" Value="#F3F3F3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 小徽章 -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="Background" Value="#E5E5E5"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 输入框（Win10：白底 + 1px 灰边） -->
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource GlassTextBox}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== 顶栏 ===== -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="联机" FontSize="23" FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Badge}" Margin="10,0,0,0">
                    <TextBlock x:Name="StatePill" Text="未连接" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                </Border>
                <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                    <TextBlock x:Name="PingText" Text="延迟 --" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="服务器" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="RegionBox" Width="132" SelectionChanged="RegionBox_SelectionChanged"/>
                <TextBlock Text="玩家名" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="PlayerNameBox" Style="{StaticResource Field}" Width="120" MaxLength="12" ToolTip="建房/加房时使用的名字"/>
                <Button x:Name="UseSaveNameBtn" Content="用存档名" Style="{StaticResource Ghost}" Click="UseSaveNameBtn_Click"/>
            </StackPanel>
        </Grid>

        <!-- ===== 页签 ===== -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="TabLobby" Content="联机大厅" Style="{StaticResource TabBtn}" Click="TabLobby_Click"/>
            <Button x:Name="TabCreate" Content="创建房间" Style="{StaticResource TabBtn}" Click="TabCreate_Click"/>
            <Button x:Name="TabJoin" Content="加入房间" Style="{StaticResource TabBtn}" Click="TabJoin_Click"/>
            <Button x:Name="TabBack" Content="← 返回大厅" Style="{StaticResource TabBtn}" Click="TabBack_Click" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ===== 内容 ===== -->
        <Grid Grid.Row="2">

            <!-- 联机大厅 -->
            <ScrollViewer x:Name="PageLobby" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="LobbyRefreshBtn" Content="刷新房间列表" Style="{StaticResource Ghost}" Click="LobbyRefreshBtn_Click"/>
                        <Button x:Name="LobbyReconnectBtn" Content="重新连接服务器" Style="{StaticResource Ghost}" Click="LobbyReconnectBtn_Click"/>
                        <TextBlock x:Name="LobbyConnText" FontSize="12" Foreground="{StaticResource SubBrush}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="LobbyHint" Text="正在读取房间列表…" FontSize="12"
                               Foreground="{StaticResource SubBrush}" Margin="2,0,0,10"/>
                    <StackPanel x:Name="RoomListPanel"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 创建房间 -->
            <ScrollViewer x:Name="PageCreate" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="创建房间" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="创建后你会成为房主：由你选择关卡并开始对局，其他玩家自动跟随进入同一关卡。"
                                       FontSize="11" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="房间人数上限" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CreateMaxBox" Grid.Column="1" Width="120" HorizontalAlignment="Left"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="房间存活时间" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="CreateTtlBox" Style="{StaticResource Field}" Width="90" Text="120"/>
                                    <TextBlock Text="分钟（120 = 2 小时）" FontSize="12" Foreground="{StaticResource SubBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="房间口令" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="CreatePassBox" Style="{StaticResource Field}" Width="180"/>
                                    <TextBlock Text="留空 = 任何人可加入" FontSize="12" Foreground="{StaticResource SubBrush}"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Grid>

                            <!-- ★ 联机时强制关闭全部修改器（不再提供选项）: 放开会导致两边不同步 -->
                            <CheckBox x:Name="CreateCheatsCheck" Style="{StaticResource NeoCheck}" Content="联机时强制关闭全部修改器（不可开）"
                                      IsChecked="False" IsEnabled="False"
                                      FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,2,0,8"/>
                            <CheckBox x:Name="CreateLateCheck" Style="{StaticResource NeoCheck}" Content="允许对局开始后中途加入"
                                      FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CreateBattleCheck" Style="{StaticResource NeoCheck}" Content="对战模式（植物 vs 僵尸）"
                                      FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="CreateBalanceCheck" Style="{StaticResource NeoCheck}" Content="人数平衡（两边人数差不超过 1）"
                                      IsChecked="True"
                                      FontSize="12" Foreground="{StaticResource TextBrush}" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CreateBtn" Content="创建房间" Style="{StaticResource Primary}" Click="CreateBtn_Click"/>
                                <TextBlock x:Name="CreateHint" FontSize="12" Foreground="{StaticResource SubBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 加入房间 -->
            <ScrollViewer x:Name="PageJoin" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="加入房间" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="向房主索取 4 位房间号（邀请码），输入后即可加入。"
                                       FontSize="11" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,6,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="房间号" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="JoinCodeBox" Grid.Column="1" Style="{StaticResource Field}" Width="160"
                                         HorizontalAlignment="Left" FontSize="18" FontWeight="Bold" MaxLength="8"/>
                            </Grid>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="口令" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center"/>
                                <TextBox x:Name="JoinPassBox" Grid.Column="1" Style="{StaticResource Field}" Width="200" HorizontalAlignment="Left"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="JoinBtn" Content="加入房间" Style="{StaticResource Primary}" Click="JoinBtn_Click"/>
                                <TextBlock x:Name="JoinHint" FontSize="12" Foreground="{StaticResource SubBrush}"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 房间（进入房间后直接显示这一页） -->
            <ScrollViewer x:Name="PageRoom" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>

                    <!-- 房间信息 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="房间号" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="RoomCodeText" Text="----" FontSize="26" FontWeight="Bold"
                                               Foreground="{StaticResource AccentDimBrush}" VerticalAlignment="Center"/>
                                    <Button x:Name="CopyCodeBtn" Content="复制邀请码" Style="{StaticResource Ghost}"
                                            Margin="14,0,0,0" VerticalAlignment="Center" Click="CopyCodeBtn_Click"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock x:Name="RoomRoleText" Text="房主" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                                    </Border>
                                    <Border Style="{StaticResource Badge}">
                                        <TextBlock x:Name="RoomCountText" Text="1/4 人" FontSize="11" Foreground="{StaticResource SubBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock x:Name="RoomMetaText" FontSize="12" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 玩家列表 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="玩家" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <StackPanel x:Name="PeerPanel"/>
                        </StackPanel>
                    </Border>

                    <!-- 对战阵营（仅对战模式显示） -->
                    <Border x:Name="FactionCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="对战阵营" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="FactionHint" FontSize="11" Foreground="{StaticResource SubBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button x:Name="JoinPlantBtn" Content="加入植物方" Style="{StaticResource Ghost}"
                                        Click="JoinPlantBtn_Click" Margin="0,0,10,0"/>
                                <Button x:Name="JoinZombieBtn" Content="加入僵尸方" Style="{StaticResource Ghost}"
                                        Click="JoinZombieBtn_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 房间设置（仅房主可改） -->
                    <Border x:Name="SettingsCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="房间设置" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                                    <TextBlock Text="人数上限" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="SetMaxBox" Width="90"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                                    <TextBlock Text="存活(分)" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SetTtlBox" Style="{StaticResource Field}" Width="80"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                                    <TextBlock Text="口令" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="SetPassBox" Style="{StaticResource Field}" Width="140"/>
                                </StackPanel>
                                <CheckBox x:Name="SetCheatsCheck" Style="{StaticResource NeoCheck}" Content="联机时修改器已强制关闭（不可开）"
                                          IsChecked="False" IsEnabled="False"
                                          FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,10"/>
                                <CheckBox x:Name="SetLateCheck" Style="{StaticResource NeoCheck}" Content="允许中途加入"
                                          FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,10"/>
                                <CheckBox x:Name="SetBattleCheck" Style="{StaticResource NeoCheck}" Content="对战模式（植物 vs 僵尸）"
                                          FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,10"/>
                                <CheckBox x:Name="SetBalanceCheck" Style="{StaticResource NeoCheck}" Content="人数平衡（两边人数差不超过 1）"
                                          FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,18,10"/>
                                <Button x:Name="ApplySetBtn" Content="应用设置" Style="{StaticResource Ghost}" Click="ApplySetBtn_Click"/>
                            </WrapPanel>
                            <!-- 逐项允许作弊（房主白名单，对齐手机版；勾选 = 允许该组，总闸关时全部忽略） -->
                            <TextBlock Text="逐项允许作弊（勾选 = 允许该组）" FontSize="12" Foreground="{StaticResource SubBrush}" Margin="0,4,0,6"/>
                            <WrapPanel x:Name="SetCheatGrid"/>
                        </StackPanel>
                    </Border>

                    <!-- 选关（房主专用） -->
                    <Border x:Name="LevelCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="选择关卡" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6"/>
                            <TextBlock Text="房主选好关卡后点「开始对局」，房间内其他人会自动进入这个关卡。不选则跟随房主当前所在关卡。"
                                       FontSize="11" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <WrapPanel x:Name="LevelCatPanel" Margin="0,0,0,8">
                                <Button x:Name="CatAdv" Content="冒险" Style="{StaticResource Ghost}" Tag="adv" Click="LevelCat_Click"/>
                                <Button x:Name="CatFun" Content="娱乐" Style="{StaticResource Ghost}" Tag="fun" Click="LevelCat_Click"/>
                                <Button x:Name="CatChallenge" Content="挑战" Style="{StaticResource Ghost}" Tag="challenge" Click="LevelCat_Click"/>
                                <Button x:Name="CatPuzzle" Content="拼图" Style="{StaticResource Ghost}" Tag="puzzle" Click="LevelCat_Click"/>
                                <Button x:Name="CatSurvival" Content="生存" Style="{StaticResource Ghost}" Tag="survival" Click="LevelCat_Click"/>
                                <Button x:Name="CatDaily" Content="每日关卡" Style="{StaticResource Ghost}" Tag="daily" Click="LevelCat_Click"/>
                                <Button x:Name="CatOnline" Content="在线关卡" Style="{StaticResource Ghost}" Tag="online" Click="LevelCat_Click"/>
                            </WrapPanel>
                            <WrapPanel Margin="0,0,0,8">
                                <TextBox x:Name="LevelSearchBox" Style="{StaticResource Field}" Width="200" TextChanged="LevelSearchBox_TextChanged"/>
                                <TextBlock Text="搜索关卡名 / 编号" FontSize="12" Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </WrapPanel>
                            <TextBlock x:Name="LevelCurText" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentDimBrush}" Margin="0,0,0,6"/>
                            <TextBlock x:Name="LevelCountText" FontSize="11" Foreground="{StaticResource SubBrush}" Margin="0,0,0,6"/>
                            <ScrollViewer Height="190" VerticalScrollBarVisibility="Auto" Background="#66FFFFFF" Padding="4">
                                <StackPanel x:Name="LevelListPanel"/>
                            </ScrollViewer>
                            <Button x:Name="LevelClearBtn" Content="清除选择（改为跟随我当前所在关卡）" Style="{StaticResource Ghost}" Margin="0,10,0,0" Click="LevelClearBtn_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 对局操作 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="对局" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <WrapPanel>
                                <Button x:Name="StartBtn" Content="开始对局" Style="{StaticResource Primary}" Margin="0,0,10,0" Click="StartBtn_Click"/>
                                <Button x:Name="EndBtn" Content="结束对局" Style="{StaticResource Ghost}" Click="EndBtn_Click"/>
                                <Button x:Name="CloseBtn" Content="解散房间" Style="{StaticResource Danger}" Click="CloseBtn_Click"/>
                                <Button x:Name="LeaveBtn" Content="离开房间" Style="{StaticResource Ghost}" Click="LeaveBtn_Click"/>
                            </WrapPanel>
                            <TextBlock x:Name="BattleHint" FontSize="11" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 聊天 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="聊天" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="ChatList"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBox x:Name="ChatBox" Style="{StaticResource Field}" Width="420" KeyDown="ChatBox_KeyDown"/>
                                <Button x:Name="SendChatBtn" Content="发送" Style="{StaticResource Ghost}" Margin="10,0,0,0" Click="SendChatBtn_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 状态栏 ===== -->
        <Border Grid.Row="3" Background="#B8D6DEE8" CornerRadius="10" Padding="12,8" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{StaticResource SubBrush}" TextWrapping="Wrap"/>
        </Border>

        <!-- ===== 进度遮罩：创建/加入/开始对局时显示转圈 + 当前在干什么 ===== -->
        <Grid x:Name="BusyOverlay" Grid.Row="0" Grid.RowSpan="4" Background="#D9F3F6FB"
              Visibility="Collapsed" Panel.ZIndex="20">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="46" Height="46" Stroke="{StaticResource AccentBrush}" StrokeThickness="4"
                         StrokeDashArray="1 3.2" StrokeDashCap="Round" HorizontalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="SpinRotate"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <TextBlock x:Name="BusyText" Text="正在处理…" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                <TextBlock x:Name="BusySubText" FontSize="12"
                           Foreground="{StaticResource SubBrush}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
