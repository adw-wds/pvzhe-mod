<Window x:Class="PvzheRemote.ScriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="脚本管理" Width="1380" Height="860" MinWidth="1000" MinHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <!-- 拟物主题（与主窗一致；CardBrushW 厚凸渐变在 App） -->
    <SolidColorBrush x:Key="CardHiBrushW" Color="{StaticResource CardHiColor}"/>
    <SolidColorBrush x:Key="LightRim" Color="#00FFFFFF"/>

    <Style x:Key="CardBtn" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource CardBrushW}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="{StaticResource LightRim}" BorderThickness="1" Effect="{StaticResource SmallShadow}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHiBrushW}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#663AAE74"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardMiniBtn" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource CardBrushW}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{StaticResource LightRim}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E3AAE74"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#663AAE74"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource WellBrush}"/>
      <Setter Property="BorderBrush" Value="#668FA3B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="bd" Property="Background" Value="#F6F9FC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 顶栏 -->
    <Grid Grid.Row="0" Background="#00FFFFFF" MouseLeftButtonDown="OnTitleBar_MouseDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Margin="16,0,0,0"
              Background="{StaticResource TileFaceHiBrush}" BorderBrush="{StaticResource LightRim}" BorderThickness="1"
              Effect="{StaticResource SmallShadow}">
        <TextBlock Text="📜" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="脚本管理" FontFamily="{StaticResource AppFont}" FontSize="14"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="玩家 C# 脚本 · 保存即写盘 · 启用的脚本会挂到功能栏对应分类" FontFamily="{StaticResource AppFont}" FontSize="10"
                   Foreground="{StaticResource SubBrush}"/>
      </StackPanel>
      <Button Grid.Column="2" Style="{StaticResource CloseButton}" Margin="12,0,16,0" Click="OnWinClose"/>
    </Grid>

    <!-- 主体：左列表 + 右编辑 -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="300"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左：脚本列表（窗底直出） -->
      <Border Grid.Column="0" Background="Transparent" BorderBrush="{StaticResource LightRim}"
              BorderThickness="0,0,1,0" Padding="14,14,14,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="脚本列表" Foreground="{StaticResource SubBrush}"
                     FontFamily="{StaticResource AppFont}" FontSize="10" Margin="4,2,0,10"/>
          <ListBox Grid.Row="1" x:Name="ScriptList" SelectionChanged="OnSelect"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Padding" Value="10,9"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="bd" Background="#00000000" CornerRadius="10"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="#333AAE74"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="bd" Property="Background" Value="#553AAE74"/>
                          <Setter TargetName="bd" Property="BorderBrush" Value="#3AAE74"/>
                          <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <Button Grid.Row="2" x:Name="BtnNew" Content="＋ 新建脚本" Height="44" Margin="4,12,4,2"
                  Style="{StaticResource CardBtn}" Click="OnNew"/>
        </Grid>
      </Border>

      <!-- 右：编辑区 -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="22,14,22,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="名称" Foreground="{StaticResource SubBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Column="1" x:Name="TbName" Style="{StaticResource CardTextBox}" Margin="0,0,16,8"/>
            <TextBlock Grid.Column="2" Text="图标" Foreground="{StaticResource SubBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,8"/>
            <TextBox Grid.Column="3" x:Name="TbIcon" Width="56" Style="{StaticResource CardTextBox}" Margin="0,0,16,8" Text="📜"/>
          </Grid>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="160"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="分类" Foreground="{StaticResource SubBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1" x:Name="CbCat" Height="30" VerticalContentAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="描述" Foreground="{StaticResource SubBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,8,0"/>
            <TextBox Grid.Column="3" x:Name="TbDesc" Style="{StaticResource CardTextBox}"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="BtnSave" Content="保存" Style="{StaticResource CardBtn}" Margin="0,0,10,0" Click="OnSave"/>
            <Button x:Name="BtnRun" Content="▶ 测试运行" Style="{StaticResource CardBtn}" Margin="0,0,10,0" Click="OnRun"/>
            <Button x:Name="BtnDelete" Content="删除" Style="{StaticResource CardBtn}" Click="OnDelete"/>
          </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" Margin="22,0,22,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource TileFaceBrush}" BorderBrush="{StaticResource LightRim}"
                  BorderThickness="1" CornerRadius="12" ClipToBounds="True" Effect="{StaticResource SoftShadow}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#20000000" Padding="12,6">
                <TextBlock Text="代码（C# / .csx）" Foreground="{StaticResource SubBrush}" FontSize="11"/>
              </Border>
              <TextBox Grid.Row="1" x:Name="TbCode" AcceptsReturn="True" AcceptsTab="True"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                       FontFamily="Consolas" FontSize="13" TextWrapping="NoWrap" Padding="10"
                       Background="#FCFDFE" BorderThickness="0"
                       Foreground="#2E3440" CaretBrush="{StaticResource AccentBrush}"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" Background="{StaticResource TileFaceBrush}" BorderBrush="{StaticResource LightRim}"
                  BorderThickness="1" CornerRadius="12" Margin="14,0,0,0" Padding="12" Effect="{StaticResource SoftShadow}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="Api 帮助" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Text="await Api.CallAsync(&quot;/sun?add=100&quot;)" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="加 100 阳光" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,10"/>
                <TextBlock Text="await Api.AddPacketAsync(&quot;PlantCherryBomb&quot;)" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="发一张樱桃炸弹卡" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,10"/>
                <TextBlock Text="await Api.SpawnAsync(&quot;PlantPeaShooter&quot;,2,3)" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="在第 2 行第 3 列种豌豆" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,10"/>
                <TextBlock Text="await Api.CmdAsync(&quot;KillAllZombies&quot;)" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="执行 MOD 命令" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,10"/>
                <TextBlock Text="await Api.AddSunAsync(100)" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="快捷加阳光" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,10"/>
                <TextBlock Text="await Api.KillAllZombiesAsync()" Foreground="{StaticResource SubBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <TextBlock Text="清空全场僵尸" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="12,0,0,10"/>
                <TextBlock Text="可写任意 C#：循环/条件/Task/自定义函数。" Foreground="{StaticResource SubBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>
    </Grid>

    <!-- 状态栏（浅凹条） -->
    <Border Grid.Row="2" Margin="16,0,16,14" Background="#E4E9F1" CornerRadius="8" Padding="12,6">
      <TextBlock x:Name="StText" Foreground="{StaticResource SubBrush}" FontSize="11" Text="选择左侧脚本进行编辑"/>
    </Border>
  </Grid>
</Window>
