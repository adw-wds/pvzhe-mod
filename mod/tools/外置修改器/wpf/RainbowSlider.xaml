<UserControl x:Class="PvzheRemote.RainbowSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Slider x:Name="Bar" Grid.Row="0" Minimum="0.5" Maximum="2" Value="1" TickFrequency="0.1"
                IsSnapToTickEnabled="True" VerticalAlignment="Center">
            <Slider.Template>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Canvas x:Name="DotLayer" Grid.Column="1" Height="8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border x:Name="TrackBg" Grid.Column="1" Height="4" CornerRadius="2"
                                Background="#E5E5E5" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <Border x:Name="Rainbow" Grid.Column="1" Height="4" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush x:Name="RainbowBrush" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF3B30" Offset="0"/>
                                    <GradientStop Color="#FF9500" Offset="0.14"/>
                                    <GradientStop Color="#FFCC00" Offset="0.28"/>
                                    <GradientStop Color="#34C759" Offset="0.42"/>
                                    <GradientStop Color="#00C7BE" Offset="0.57"/>
                                    <GradientStop Color="#007AFF" Offset="0.71"/>
                                    <GradientStop Color="#AF52DE" Offset="0.85"/>
                                    <GradientStop Color="#FF3B30" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Track x:Name="PART_Track" Grid.Column="1">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" Opacity="0"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" Opacity="0"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Slider.Template>
        </Slider>
        <Grid Grid.Row="1" Margin="2,4,2,0">
            <TextBlock x:Name="ValLabel" FontFamily="{StaticResource AppFont}" FontSize="12"
                       FontWeight="Bold" Foreground="{StaticResource SubBrush}" Text="1.0x" HorizontalAlignment="Left"/>
        </Grid>
    </Grid>
</UserControl>
