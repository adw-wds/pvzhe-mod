<Application x:Class="PvzheRemote.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PvzheRemote"
             xmlns:neu="clr-namespace:WPF_Neumorphism_Plus;assembly=WPF_Neumorphism_Plus"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ========== 新拟物色板（暖浅灰底 + 冷灰蓝柔影 + 柔绿强调） ========== -->
        <!-- ========== Win10 设置风色板（平面纯色 + 细边框） ========== -->
        <Color x:Key="GlassColor">#FFFFFF</Color>    <!-- 浮层/弹层底 -->
        <Color x:Key="CardColor">#FFFFFF</Color>     <!-- 卡片底 -->
        <Color x:Key="CardHiColor">#FFFFFF</Color>   <!-- 卡高亮 -->
        <Color x:Key="BorderColor">#E5E5E5</Color>   <!-- 细线/分隔 -->
        <Color x:Key="TextColor">#1A1A1A</Color>     <!-- 主字 -->
        <Color x:Key="SubColor">#666666</Color>      <!-- 次字 -->
        <Color x:Key="AccentColor">#0078D4</Color>   <!-- Win10 强调蓝 -->
        <Color x:Key="AccentDimColor">#106EBE</Color>
        <Color x:Key="DangerColor">#C42B1C</Color>   <!-- 未连接红 -->
        <Color x:Key="GrayColor">#8A8A8A</Color>     <!-- 待机灰 -->
        <Color x:Key="TrackOffColor">#8A8A8A</Color> <!-- 开关关轨道边 -->
        <Color x:Key="WellColor">#FFFFFF</Color>     <!-- 输入框/复选框底（Win10 是白底） -->
        <Color x:Key="WellHiColor">#E5E5E5</Color>   <!-- 轨道/按压 -->

        <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>
        <SolidColorBrush x:Key="CardHiBrush" Color="{StaticResource CardHiColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="SubBrush" Color="{StaticResource SubColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDimColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="GrayBrush" Color="{StaticResource GrayColor}"/>
        <SolidColorBrush x:Key="TrackOffBrush" Color="{StaticResource TrackOffColor}"/>
        <SolidColorBrush x:Key="WellBrush" Color="{StaticResource WellColor}"/>
        <SolidColorBrush x:Key="WellHiBrush" Color="{StaticResource WellHiColor}"/>

        <!-- ========== 面刷：一概纯色（Win10 无渐变） ========== -->
        <SolidColorBrush x:Key="CardBrushW" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TileFaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TileFaceHiBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="WellFaceBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WellPressedBrush" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="WellPressedHiBrush" Color="#FFFFFF"/>
        <!-- 按压最深（实色） -->
        <SolidColorBrush x:Key="PressedDeepBrush" Color="#E5E5E5"/>
        <!-- 凹口勾勒描边 -->
        <SolidColorBrush x:Key="PressedRim" Color="#E5E5E5"/>

        <!-- ★ Segoe UI 优先（Win10 观感），中文自动回退雅黑。
             键名保持 AppFont 不变 → 全工程几百处 FindResource("AppFont") 自动跟着变。 -->
        <FontFamily x:Key="AppFont">Segoe UI, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="MonoFont">Consolas</FontFamily>
        <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI</FontFamily>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

        <!-- ===== Win10 新增色键 ===== -->
        <SolidColorBrush x:Key="AccentTextBrush" Color="#0078D4"/>
        <SolidColorBrush x:Key="NavBgBrush"       Color="#F3F3F3"/>
        <SolidColorBrush x:Key="NavSelBrush"      Color="#E5E5E5"/>
        <SolidColorBrush x:Key="NavHoverBrush"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="LineBrush"        Color="#E5E5E5"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="DangerHiBrush"    Color="#E81123"/>
        <SolidColorBrush x:Key="TrackBgBrush"     Color="#E5E5E5"/>

        <!-- ★ Win10 无阴影。这三个键仍被 5 个窗口的 XAML 引用（逐处删 Effect= 会遇到重复文本
             匹配失败，而且删键会让 StaticResource 找不到直接崩），所以保留键名、做成完全不可见。 -->
        <DropShadowEffect x:Key="SoftShadow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000"/>
        <DropShadowEffect x:Key="TileShadow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000"/>
        <DropShadowEffect x:Key="SmallShadow" BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#000000"/>

        <!-- ===== 新拟物 Shader（只保留右下柔和暗影，去掉白亮影以免亮背景出白边） ===== -->
        <neu:Neumorphism_Plus_Shader x:Key="NeuCard" BorderRadius="12"
                                     OffsetX="5" OffsetY="4" BlurRadius="3" SpreadRadius="0"
                                     PrimaryColor="#4D7B8FA4" SecondaryColor="#00FFFFFF" Inset="0"/>
        <neu:Neumorphism_Plus_Shader x:Key="NeuMid" BorderRadius="10"
                                     OffsetX="5" OffsetY="4" BlurRadius="3" SpreadRadius="0"
                                     PrimaryColor="#4D7B8FA4" SecondaryColor="#00FFFFFF" Inset="0"/>
        <neu:Neumorphism_Plus_Shader x:Key="NeuSmall" BorderRadius="8"
                                     OffsetX="4" OffsetY="3" BlurRadius="3" SpreadRadius="0"
                                     PrimaryColor="#4D7B8FA4" SecondaryColor="#00FFFFFF" Inset="0"/>

        <!-- ========== 全局拟物滑块（系统 Slider 的凹陷轨道 + 凸圆钮） ========== -->
        <Style TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- 未来 Win10：灰轨道 4px + 左侧强调蓝填充（由 Decrease 段自动撑到滑块处） -->
                            <Border x:Name="TrackBg" Height="4" CornerRadius="2"
                                    Background="{StaticResource TrackBgBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="20" Height="20" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{StaticResource InputBorderBrush}" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 纯文字按钮（无背景方块，只显示内容） ========== -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮（拟物：普通透明，悬停浮起红，按下凹陷） -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}" CornerRadius="9">
                            <TextBlock Text="&#xE8BB;" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" FontFamily="{StaticResource IconFont}" FontSize="10"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3DFF5F57"/>
                                <Setter Property="Foreground" Value="#FF5F57"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 拟物输入框：默认内凹（比底深），聚焦浮起 + 柔绿描边 -->
        <Style x:Key="GlassTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource WellBrush}"/>
            <Setter Property="BorderBrush" Value="#668FA3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <!-- 固定最小高度 + 内容垂直居中：避免中文行高不足导致文字被裁一半 -->
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="#F6F9FC"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 新拟物复选框：18 圆角方块 + 选中柔绿对勾 -->
        <Style x:Key="NeoCheck" TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="2"
                                    Background="{StaticResource WellBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="tick" Data="M 3,7 L 7,11 L 13,4" Stroke="White" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentDimBrush}"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 全应用复选框统一用 Win10 方角样式 -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource NeoCheck}"/>

        <!-- ================= Win10 设置风控件模板 ================= -->

        <!-- 卡片：高不透明度白（#D9=85%）+ 1px 细线 + 圆角 4。
             ★ 不做背景模糊（BlurEffect 会把视频弄坏），靠卡片不透明度保证可读性。 -->
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#D9FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- 页面大标题 28px Light -->
        <Style x:Key="SettingsTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Light"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- 分组小标题 14px Semibold -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Margin" Value="0,12,0,6"/>
        </Style>

        <!-- 说明文字 12px 灰 -->
        <Style x:Key="DescText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SubBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- 链接文字 -->
        <Style x:Key="LinkText" TargetType="TextBlock" BasedOn="{StaticResource DescText}">
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 左栏导航项：常态透明 / hover 灰 / 选中灰底 + 左侧 3px 强调竖条
             ★ DataContext 存分类 key（识别是哪项），Tag 只当 "sel" 选中标记（两者不能混用） -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="root" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="tr" X="0" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}" Visibility="Collapsed"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="barSc" ScaleY="1"/>
                                </Border.RenderTransform>
                            </Border>
                            <ContentPresenter Margin="16,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="sel">
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Background" Value="{StaticResource NavSelBrush}"/>
                                <!-- 选中竖条「长出来」（Win10 NavigationView 的选中指示条） -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="barSc" Storyboard.TargetProperty="ScaleY"
                                                             From="0.2" To="1" Duration="0:0:0.18">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <!-- ★ 按下手感：整体下移 1.5px + 纵向压扁到 0.96，底色加深（像被按下去） -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#DDDDDD"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y"
                                                             To="1.5" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY"
                                                             To="0.96" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX"
                                                             To="0.99" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="tr" Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.13"/>
                                            <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.13"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮 46×32（图标用 Segoe MDL2） -->
        <Style x:Key="TitleBtn" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavSelBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关闭按钮：hover 红底白字 -->
        <Style x:Key="TitleBtnClose" TargetType="Button" BasedOn="{StaticResource TitleBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource DangerHiBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C42B1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 左栏搜索框：左放大镜 + 下边框（Win10 设置那个搜索框） -->
        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="0,0,0,1" CornerRadius="2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Foreground="{StaticResource SubBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <ScrollViewer Grid.Column="1" x:Name="PART_ContentHost" VerticalAlignment="Center"
                                              Margin="0,0,8,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win10 主按钮（蓝底白字） -->
        <Style x:Key="WinPrimary" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource AccentBrush}" CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Win10 次按钮（白底 + 1px 边） -->
        <Style x:Key="WinSecondary" TargetType="Button" BasedOn="{StaticResource WinPrimary}">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="{StaticResource InputBorderBrush}"
                                BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#F0F0F0"/>
                                <Setter Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框：先只设属性（不重写 ComboBox 模板 —— PART_Popup 写错会让所有下拉失效） -->
        <Style x:Key="SettingsCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="160"/>
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="8,0"/>
        </Style>

        <!-- 下拉弹层项：Win10 观感（hover 灰、选中蓝调） -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E5E5E5"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#CCE4F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
