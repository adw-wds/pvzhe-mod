<Window x:Class="PvzheRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PvzheRemote"
        Title="杂交版 外置修改器" Width="1120" Height="760" MinWidth="980" MinHeight="640"
        WindowStyle="None" AllowsTransparency="False" Background="#FFFFFF"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Loaded="OnWindowLoaded">
    <Window.Resources>

        <!-- 拟物卡片色（CardBrushW 厚凸渐变定义于 App；key 保持兼容 code-behind） -->
        <SolidColorBrush x:Key="CardHiBrushW" Color="{StaticResource CardHiColor}"/>
        <SolidColorBrush x:Key="LightRim" Color="#00FFFFFF"/>   <!-- 白描边已禁用（防白边） -->

        <!-- ========== 分类方块（竖向横条，浮起厚卡；选中由 code 填柔绿） ========== -->
        <Style x:Key="CatTile" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}" CornerRadius="2"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 正方形按钮（Win10 平面小方钮） ========== -->
        <Style x:Key="SquareButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}" CornerRadius="2"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DDDDDD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== 功能项小方块（真新拟物外凸双影） ========== -->
        <Style x:Key="FeatTile" TargetType="Border">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <!-- 直角窗口（Win10）。背景图由 code-behind 启动时按 exe 同目录的 wallpaper.* 自动加载 -->
    <Border BorderThickness="0" CornerRadius="0"
            Background="{StaticResource WindowBgBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ★ 背景图（最底层）。把图片命名为 bg.png / bg.jpg / bg.jpeg / bg.webp
                 放到 exe 同目录（或 exe\bg\ 子目录）即可换图，不用重新编译。 -->
            <!-- ★ 不要给背景层加 BlurEffect：会同时导致 ①整体发糊 ②视频只渲染出一部分
                 （WPF 要先把视频画进位图再模糊，宽高比和更新范围都会出问题）。
                 磨砂感改由不透明白色卡片保证。 -->
            <Image x:Name="BgImage" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="0.85"
                   IsHitTestVisible="False"/>
            <MediaElement x:Name="BgVideo" Grid.RowSpan="2" Stretch="UniformToFill" Opacity="1"
                          IsMuted="True" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                          IsHitTestVisible="False" Visibility="Collapsed"/>

            <!-- ★ 背景图（横图 / 躺姿构图最合适）。没图片时 Source 为空 = 什么都不显示，
                 所以不需要图片也能正常用。白罩保证上面文字可读。 -->
            <Image x:Name="Wallpaper" Grid.RowSpan="2" Stretch="UniformToFill" IsHitTestVisible="False"/>
            <!-- （白色蒙版已移除：它会盖住背景图/视频。文字可读性由不透明白色卡片保证） -->

            <!-- ========== 标题栏 ========== -->
            <Grid Grid.Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- MOD 图标（左上角，真新拟物小磁贴） -->
                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="4" Margin="16,0,0,0"
                        Background="White">
                    <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="18"
                               Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="杂交版 外置修改器" Foreground="{StaticResource TextBrush}"
                               FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
                <Border Grid.Column="2" Width="1" Height="26" Background="{StaticResource BorderBrush}" Margin="18,0,0,0"/>

                <Border Grid.Column="3" Height="1" Background="{StaticResource BorderBrush}" Margin="18,0,18,0" VerticalAlignment="Center"/>

                <Ellipse Grid.Column="4" x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource GrayBrush}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="5" x:Name="StatusText" Text="未连接" Foreground="{StaticResource SubBrush}"
                           FontFamily="{StaticResource AppFont}" FontSize="11" Margin="7,0,0,0" VerticalAlignment="Center"/>
                <Button Grid.Column="6" Content="&#xE945;" Style="{StaticResource TitleBtn}" Margin="12,0,0,0" Click="OnDetect" ToolTip="检测连接"/>
                <Button Grid.Column="7" Content="&#xE8BB;" Style="{StaticResource TitleBtnClose}" Margin="0" Click="OnClose"/>
            </Grid>

            <!-- ========== 主体：左栏 + 右栏 ========== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左栏：Win10 设置式导航（半透明底 → 背景图能透出来） -->
                <Border Grid.Column="0" Background="#CCF3F3F3" BorderThickness="0" Padding="0,10,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="设置" Foreground="{StaticResource TextBrush}"
                                   FontFamily="{StaticResource UiFont}" FontSize="14" FontWeight="SemiBold" Margin="16,0,0,10"/>
                        <TextBox Grid.Row="1" x:Name="SearchInput" Style="{StaticResource SearchBox}"
                                 Margin="12,0,12,8" TextChanged="SearchInput_TextChanged"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="CatPanel"/>
                        </ScrollViewer>
                        <!-- 用户中心（左下角，真新拟物外凸入口） -->
                        <Button Grid.Row="3" x:Name="UserBtn" Height="44" Margin="0,10,0,0" Cursor="Hand"
                                Background="Transparent" Click="OnUserCenter"
                                HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}" CornerRadius="0"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Margin="16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="用户中心" Foreground="{StaticResource TextBrush}" FontFamily="{StaticResource UiFont}"
                                               FontSize="13"/>
                                    <TextBlock Text="存档状态 · 使用时长" Foreground="{StaticResource SubBrush}" FontFamily="{StaticResource UiFont}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                           Foreground="{StaticResource SubBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!-- 右栏：内容区 -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 内容（页面大标题 + 首页 / 功能方块 / 日志） -->
                    <ScrollViewer Grid.Row="0" x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,28,32,10">
                            <TextBlock x:Name="PageTitle" Style="{StaticResource SettingsTitle}"/>
                            <StackPanel x:Name="ContentPanel"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 滑块展开面板（真新拟物外凸面板） -->
                    <Border Grid.Row="1" x:Name="SliderPanel" Visibility="Collapsed" Margin="32,6,32,14"
                            Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,18,0">
                                <TextBlock x:Name="SliderTitle" Text="游戏速度" Foreground="{StaticResource TextBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="SliderSub" Text="调节游戏整体运行速度" Foreground="{StaticResource SubBrush}"
                                           FontFamily="{StaticResource AppFont}" FontSize="9" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Grid x:Name="SliderBody" Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
