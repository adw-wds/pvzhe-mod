<Window x:Class="PvzheRemote.CustomPlantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义项目" Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStyle="None" AllowsTransparency="True" Background="{StaticResource WindowBgBrush}"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <!-- 拟物主题（与主窗一致；CardBrushW 厚凸渐变在 App） -->
    <SolidColorBrush x:Key="CardHiBrushW" Color="{StaticResource CardHiColor}"/>
    <SolidColorBrush x:Key="LightRim" Color="#00FFFFFF"/>

    <!-- 画布棋盘格透明底（2px 一格，随画布缩放保持与像素格对齐） -->
    <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,2,2" ViewportUnits="Absolute">
      <DrawingBrush.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="#FFC8C8C8">
            <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,2,2"/></GeometryDrawing.Geometry>
          </GeometryDrawing>
          <GeometryDrawing Brush="#FFFFFFFF">
            <GeometryDrawing.Geometry><GeometryGroup>
              <RectangleGeometry Rect="0,0,1,1"/>
              <RectangleGeometry Rect="1,1,1,1"/>
            </GeometryGroup></GeometryDrawing.Geometry>
          </GeometryDrawing>
        </DrawingGroup>
      </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ========== 分类条（竖向，浮起厚卡） ========== -->
    <Style x:Key="CatTile" TargetType="Button">
      <Setter Property="Height" Value="52"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{StaticResource CardBrushW}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Transparent}" CornerRadius="14"
                    BorderBrush="{StaticResource LightRim}" BorderThickness="1" Effect="{StaticResource SmallShadow}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#663AAE74"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CatTileActive" TargetType="Button" BasedOn="{StaticResource CatTile}">
      <Setter Property="Background" Value="#DFF2E7"/>
      <Setter Property="BorderBrush" Value="#663AAE74"/>
    </Style>

    <!-- ========== 浅色卡片按钮（浮起厚卡） ========== -->
    <Style x:Key="CardBtn" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource CardBrushW}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                    BorderBrush="{StaticResource LightRim}" BorderThickness="1" Effect="{StaticResource SmallShadow}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource CardHiBrushW}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#663AAE74"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardBtnActive" TargetType="Button" BasedOn="{StaticResource CardBtn}">
      <Setter Property="Background" Value="#DFF2E7"/>
      <Setter Property="BorderBrush" Value="#663AAE74"/>
      <Setter Property="Foreground" Value="{StaticResource AccentDimBrush}"/>
    </Style>

    <!-- ========== 卡片网格小按钮（浮起） ========== -->
    <Style x:Key="CardMiniBtn" TargetType="Button">
      <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="{StaticResource CardBrushW}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="5,3"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{StaticResource LightRim}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E3AAE74"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#663AAE74"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ========== 浅色输入框（内凹） ========== -->
    <Style x:Key="CardTextBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource WellBrush}"/>
      <Setter Property="BorderBrush" Value="#668FA3B8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Padding" Value="9,4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                            VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"
                            VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="bd" Property="Background" Value="#F6F9FC"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ========== 浅色下拉框 ========== -->
    <Style x:Key="CardComboBoxItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="3,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#2E3AAE74"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#553AAE74"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CardComboBox" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource CardComboBoxItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton x:Name="ToggleBtn" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" Background="{StaticResource WellBrush}" CornerRadius="8"
                            BorderBrush="#668FA3B8" BorderThickness="1">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="26"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="10,0,4,0" VerticalAlignment="Center"
                                          Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                          ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock Grid.Column="1" Text="▾" Foreground="{StaticResource SubBrush}" FontSize="10"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="#663AAE74"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                     Placement="Bottom" VerticalOffset="4" StaysOpen="False" PopupAnimation="Slide">
                <Border Background="#F4F7FB" BorderBrush="{StaticResource LightRim}" BorderThickness="1"
                        CornerRadius="10" Margin="0,6" Padding="2" Effect="{StaticResource SmallShadow}">
                  <ScrollViewer MaxHeight="220">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="58"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- ========== 顶栏：标题 + 关闭 ========== -->
    <Grid Grid.Row="0" Background="#00FFFFFF" MouseLeftButtonDown="TitleBar_MouseDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Width="40" Height="40" CornerRadius="12" Margin="16,0,0,0"
              Background="{StaticResource TileFaceHiBrush}" BorderBrush="{StaticResource LightRim}" BorderThickness="1"
              Effect="{StaticResource SmallShadow}">
        <TextBlock Text="自" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="WinTitle" Text="自定义项目" FontFamily="{StaticResource AppFont}" FontSize="14"
                   FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
      </StackPanel>
      <Border Grid.Column="2" Height="1" Background="{StaticResource BorderBrush}" Margin="18,0,18,0" VerticalAlignment="Center"/>
      <Button Grid.Column="3" x:Name="WinClose" Style="{StaticResource CloseButton}" Margin="12,0,16,0" Click="OnWinClose"/>
    </Grid>

    <!-- ========== 主体：左分类 + 右内容区 ========== -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左分类栏（窗底直出） -->
      <Border Grid.Column="0" Background="Transparent" BorderBrush="{StaticResource LightRim}"
              BorderThickness="0,0,1,0" Padding="14,14,14,14">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="项目分类" Foreground="{StaticResource SubBrush}"
                     FontFamily="{StaticResource AppFont}" FontSize="10" Margin="10,2,0,12"/>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CatPanel">
              <Button x:Name="CatPlant" Content="植物" Style="{StaticResource CatTile}" Click="OnCatPlant"/>
              <Button x:Name="CatZombie" Content="僵尸" Style="{StaticResource CatTile}" Click="OnCatZombie"/>
              <Button x:Name="CatBullet" Content="子弹" Style="{StaticResource CatTile}" Click="OnCatBullet"/>
              <Button x:Name="CatCard" Content="卡牌" Style="{StaticResource CatTile}" Click="OnCatCard"/>
              <Button x:Name="CatShare" Content="分享" Style="{StaticResource CatTile}" Click="OnCatShare"/>
              <Button x:Name="CatSettings" Content="设置" Style="{StaticResource CatTile}" Click="OnCatSettings"/>
            </StackPanel>
          </ScrollViewer>
          <Button Grid.Row="2" x:Name="NewBtn" Content="新建" Height="52" Margin="4,14,4,2"
                  Style="{StaticResource CardBtn}" Click="OnNew"/>
        </Grid>
      </Border>

      <!-- 右内容区：列表视图 / 编辑视图 / 分享占位 / 设置占位 -->
      <Grid Grid.Column="1" x:Name="ContentView" Background="Transparent">
        <!-- 列表视图：项目卡片网格 -->
        <Grid x:Name="ListView">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="22,18,22,4">
            <TextBlock x:Name="ListTitle" Text="植物" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ListHint" Foreground="{StaticResource SubBrush}" FontSize="11"
                       Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="14,6,14,14">
            <WrapPanel x:Name="CardGrid" HorizontalAlignment="Left"/>
          </ScrollViewer>
        </Grid>

        <!-- 编辑视图：画板 + 表单 -->
        <Grid x:Name="EditView" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="22,14,22,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="返回列表" Style="{StaticResource CardBtn}" Click="OnEditBack"/>
              <TextBlock Grid.Column="1" x:Name="EditTitle" Text="编辑" FontSize="16" FontWeight="Bold"
                         Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="14,0,0,0"/>
              <Border Grid.Column="2" Width="1" Height="26" Background="{StaticResource BorderBrush}" Margin="14,0"/>
              <TextBlock Grid.Column="3" x:Name="CanvasHint" Text="待机帧 · 左键画 · 右键擦"
                         Foreground="{StaticResource SubBrush}" FontSize="12" VerticalAlignment="Center"/>
              <Button Grid.Column="4" Content="保存" Style="{StaticResource CardBtnActive}" Click="OnEditSave"/>
              <Button Grid.Column="5" x:Name="AutoGenBtn" Content="自动生成帧" Style="{StaticResource CardBtn}" Margin="8,0,0,0" Click="OnAutoGenerateFrames"/>
               <Button Grid.Column="6" x:Name="ExportSpriteBtn" Content="导出精灵表" Style="{StaticResource CardBtn}" Margin="8,0,0,0" Click="OnExportSpriteSheet"/>
               <Button Grid.Column="7" x:Name="ExportGifBtn" Content="导出 GIF" Style="{StaticResource CardBtn}" Margin="8,0,0,0" Click="OnExportGif"/>
          </Grid>

          <Grid Grid.Row="1" Margin="22,6,22,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 画板区（Aseprite 风格：左工具 + 大画布 + 底部颜色条） -->
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- Row0：帧切换 -->
              <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="FrameIdleBtn" Content="待机帧" Width="92" Height="34" Style="{StaticResource CardBtnActive}" Click="OnFrameIdle"/>
                <Button x:Name="FrameAttackBtn" Content="攻击帧" Width="92" Height="34" Margin="8,0,0,0" Style="{StaticResource CardBtn}" Click="OnFrameAttack"/>
              </StackPanel>

              <!-- Row1：顶部条（标题 + 缩放放大镜 + 分辨率） -->
              <Border Grid.Row="1" Background="{StaticResource TileFaceBrush}" CornerRadius="12"
                      BorderBrush="{StaticResource LightRim}" BorderThickness="1" Padding="12,6" Effect="{StaticResource SmallShadow}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="CanvasTitleText" Grid.Column="0" Text="画布 · 128×128 · 待机帧"
                             Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold"
                             VerticalAlignment="Center" Margin="0,0,12,0"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="缩放" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}" Margin="0,0,6,0"/>
                    <Slider x:Name="ZoomSlider" Minimum="0.25" Maximum="8" Value="1" Width="160" SmallChange="0.1" LargeChange="0.5" ValueChanged="OnZoomChanged"/>
                    <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource SubBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="分辨率" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}" Margin="0,0,6,0"/>
                    <ComboBox x:Name="ResolutionBox" Width="72" Height="26" SelectionChanged="OnResolutionChanged" Style="{StaticResource CardComboBox}">
                      <ComboBoxItem Content="64"/>
                      <ComboBoxItem Content="128"/>
                      <ComboBoxItem Content="256"/>
                      <ComboBoxItem Content="512"/>
                      <ComboBoxItem Content="1080"/>
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Row2：左工具 + 画布 -->
              <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：垂直工具栏 -->
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                  <Button Content="画笔" x:Name="BtnPen" Width="72" Height="34" Style="{StaticResource CardMiniBtn}" Click="OnToolPenUpdated"/>
                  <Button Content="橡皮" x:Name="BtnEraser" Width="72" Height="34" Margin="0,6,0,0" Style="{StaticResource CardMiniBtn}" Click="OnToolEraserUpdated"/>
                  <Button Content="吸色" x:Name="BtnEyedrop" Width="72" Height="34" Margin="0,6,0,0" Style="{StaticResource CardMiniBtn}" Click="OnToolEyedropUpdated"/>
                  <Button Content="填充" x:Name="BtnFill" Width="72" Height="34" Margin="0,6,0,0" Style="{StaticResource CardMiniBtn}" Click="OnToolFillUpdated"/>
                  <Button Content="导入" Width="72" Height="34" Margin="0,10,0,0" Style="{StaticResource CardMiniBtn}" Click="OnImport"/>
                  <Button Content="撤销" Width="72" Height="34" Margin="0,6,0,0" Style="{StaticResource CardMiniBtn}" Click="OnUndo"/>
                  <Button Content="清空" Width="72" Height="34" Margin="0,6,0,0" Style="{StaticResource CardMiniBtn}" Click="OnClear"/>
                </StackPanel>

                <!-- 画布 -->
                <Border Grid.Column="1" Background="{StaticResource TileFaceBrush}" CornerRadius="16"
                        BorderBrush="{StaticResource LightRim}" BorderThickness="1" ClipToBounds="True"
                        Effect="{StaticResource SoftShadow}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Grid.Row="0" x:Name="CanvasScroller"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Margin="12,10,12,0" SizeChanged="OnCanvasScrollerSizeChanged">
                      <Grid x:Name="CanvasHost" Width="128" Height="128"
                            MinWidth="{Binding ActualWidth, ElementName=CanvasScroller}"
                            MinHeight="{Binding ActualHeight, ElementName=CanvasScroller}">
                        <Rectangle x:Name="CheckerRect" Fill="{StaticResource CheckerBrush}"
                                   RenderTransformOrigin="0.5,0.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Rectangle.RenderTransform>
                            <ScaleTransform x:Name="CheckerScale" ScaleX="1" ScaleY="1"/>
                          </Rectangle.RenderTransform>
                        </Rectangle>
                        <Image x:Name="CanvasImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                          <Image.RenderTransform>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="1" ScaleY="1"/>
                          </Image.RenderTransform>
                        </Image>
                        <Canvas x:Name="GridOverlay" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                          <Canvas.RenderTransform>
                            <ScaleTransform x:Name="GridScale" ScaleX="1" ScaleY="1"/>
                          </Canvas.RenderTransform>
                        </Canvas>
                      </Grid>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="12,8,12,10" Background="#E1E7EF" CornerRadius="8" Padding="10,5">
                      <TextBlock x:Name="StatusBarText" Foreground="{StaticResource SubBrush}" FontSize="11"
                                 Text="坐标 (0,0) · 缩放 100% · 工具:画笔 · 颜色 #50C85A"/>
                    </Border>
                  </Grid>
                </Border>
              </Grid>

              <!-- Row3：底部颜色条 + 笔刷大小 -->
              <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <WrapPanel x:Name="ColorBar" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Vertical" Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="笔刷大小" Foreground="{StaticResource SubBrush}" FontSize="11" HorizontalAlignment="Center"/>
                  <Slider x:Name="PenSizeSlider" Minimum="1" Maximum="16" Value="2" Width="120" ValueChanged="OnPenSizeChanged"/>
                  <Border x:Name="ColorPreview" Width="28" Height="28" CornerRadius="6" Margin="6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                </StackPanel>
              </StackPanel>

              <!-- Row4：帧预览条（自动生成帧后显示） -->
              <Border Grid.Row="4" x:Name="FramePreviewPanel" Margin="0,10,0,0" Visibility="Collapsed"
                      Background="#E4E9F1" CornerRadius="10" Padding="10,6">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <TextBlock Text="帧预览" VerticalAlignment="Center" Foreground="{StaticResource SubBrush}" Margin="0,0,8,0"/>
                  <Slider x:Name="FramePreviewSlider" Width="180" Minimum="0" Maximum="5" Value="0"
                          VerticalAlignment="Center" ValueChanged="OnFramePreviewChanged"/>
                  <Border Width="52" Height="52" Margin="10,0,0,0" Background="#DDE4EC" CornerRadius="6"
                          BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <Image x:Name="FramePreviewImage" Stretch="None"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Button x:Name="ApplyFrameBtn" Content="套用该帧" Style="{StaticResource CardMiniBtn}"
                          Margin="10,0,0,0" Click="OnApplyFrame"/>
                  <TextBlock x:Name="FramePreviewIdx" Text="0/5" VerticalAlignment="Center"
                             Foreground="{StaticResource SubBrush}" Margin="8,0,0,0"/>
                </StackPanel>
              </Border>
            </Grid>

            <!-- 表单区 -->
            <Border Grid.Column="1" Background="{StaticResource TileFaceBrush}" BorderBrush="{StaticResource LightRim}"
                    BorderThickness="1" CornerRadius="16" Margin="18,0,0,0" Effect="{StaticResource SoftShadow}">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,14,16,14" x:Name="ParamPanel">
                  <!-- 帧生成面板（可折叠，默认收起省空间） -->
                  <Expander Header="帧生成 · 自动动画帧" IsExpanded="False" Margin="0,0,0,8"
                            Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold">
                    <Border Background="#0D000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,6,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="60"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="帧数" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="AutoFramesBox" Text="6" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="模式" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="AutoMode" Height="26" Margin="0,0,0,8" SelectedIndex="1">
                          <ComboBoxItem>translate</ComboBoxItem>
                          <ComboBoxItem>rotate</ComboBoxItem>
                          <ComboBoxItem>scale</ComboBoxItem>
                          <ComboBoxItem>combo</ComboBoxItem>
                          <ComboBoxItem>tween</ComboBoxItem>
                          <ComboBoxItem>template</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="模板" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="AutoTemplateBox" Height="26" Margin="0,0,0,8" SelectedIndex="0">
                          <ComboBoxItem>breath</ComboBoxItem>
                          <ComboBoxItem>swing</ComboBoxItem>
                          <ComboBoxItem>shake</ComboBoxItem>
                          <ComboBoxItem>attack</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="位移" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="AutoTranslateBox" Text="0.12" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="旋转" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,8"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="AutoRotateBox" Text="8" Height="26" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="缩放%" Foreground="{StaticResource TextBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="AutoScaleBox" Text="1.05" Height="26" VerticalContentAlignment="Center"/>
                      </Grid>
                    </Border>
                  </Expander>
                  <!-- 实时预览（可折叠） -->
                  <Expander Header="实时预览" IsExpanded="True" Margin="0,0,0,8"
                            Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="Bold">
                    <Border Background="#0D000000" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,6,0,0">
                      <StackPanel>
                        <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="96"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#DDE4EC" CornerRadius="8" Width="84" Height="84" HorizontalAlignment="Left">
                          <Image x:Name="PreviewImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" x:Name="PreviewText" Foreground="{StaticResource TextBrush}" FontSize="11"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0"/>
                      </Grid>
                    </StackPanel>
                    </Border>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <!-- 分享：导出 / 导入 .cproj（SP7） -->
        <ScrollViewer x:Name="ShareView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
          <StackPanel x:Name="SharePanel" Margin="30,22,30,30" HorizontalAlignment="Center"/>
        </ScrollViewer>

        <!-- 设置占位（SP7 实现） -->
        <StackPanel x:Name="SettingsView" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="设置" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="启动自动加载等设置将在后续版本提供" FontSize="13" Foreground="{StaticResource SubBrush}" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
